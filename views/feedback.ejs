<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>🛡️ Fitur Mandiri: Form Feedback & Ulasan Aman</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 min-h-screen text-slate-800">
  <header class="bg-white border-b border-slate-200 py-4 px-6 mb-6 sticky top-0 z-30 shadow-sm flex items-center justify-between">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-xl font-bold text-slate-800">Ulasan & Feedback Pelanggan</h1>
        <span class="bg-emerald-100 text-emerald-800 text-xs font-semibold px-2.5 py-0.5 rounded-full">🛡️ Bagian 2: Aman</span>
      </div>
      <p class="text-sm text-slate-500">
        Halo, <strong><%= username %></strong> 👋 &bull; 
        <a href="/demo" class="text-indigo-600 hover:underline">Hub Demo</a> &bull; 
        <a href="/search" class="text-indigo-600 hover:underline">Cari Produk</a>
      </p>
    </div>
    <form method="POST" action="/logout">
      <button class="text-sm bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 px-3 py-1.5 rounded-lg font-medium transition">Logout</button>
    </form>
  </header>

  <main class="max-w-4xl mx-auto px-4 pb-16">
    <!-- Security Banner -->
    <div class="bg-indigo-50 border border-indigo-200 rounded-xl p-4 mb-6 shadow-sm">
      <h2 class="text-sm font-semibold text-indigo-900 mb-1 flex items-center gap-1.5">
        <span>🔒</span> Pilar Keamanan yang Diterapkan pada Halaman Ini:
      </h2>
      <ul class="text-xs text-indigo-800 grid grid-cols-1 md:grid-cols-2 gap-2 mt-2">
        <li class="flex items-center gap-1.5">✅ <strong>Server-Side Validation:</strong> express-validator (panjang, regex alfanumerik, format email, range rating)</li>
        <li class="flex items-center gap-1.5">🧹 <strong>Sanitasi Input:</strong> <code>.trim()</code>, <code>.escape()</code>, <code>.normalizeEmail()</code></li>
        <li class="flex items-center gap-1.5">🛡️ <strong>HTML Escaping:</strong> Output dirender menggunakan <code>&lt;%= %&gt;</code> di template EJS</li>
        <li class="flex items-center gap-1.5">💉 <strong>Anti-SQL Injection:</strong> Parameterized Query via Sequelize ORM</li>
      </ul>
    </div>

    <!-- Error Validation Messages (Server-Side) -->
    <% if (errors && errors.length > 0) { %>
      <div id="validation-errors" class="bg-rose-50 border-l-4 border-rose-500 text-rose-800 p-4 rounded-r-xl mb-6 shadow-sm">
        <div class="flex items-center gap-2 font-bold mb-1 text-rose-900">
          <svg class="w-5 h-5 text-rose-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg>
          Input Ditolak oleh Server (Validasi Server-Side Gagal):
        </div>
        <ul class="list-disc list-inside text-sm space-y-1 ml-1">
          <% errors.forEach(function(err) { %>
            <li><%= err %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <!-- Success Message -->
    <% if (success) { %>
      <div id="success-alert" class="bg-emerald-50 border-l-4 border-emerald-500 text-emerald-800 p-4 rounded-r-xl mb-6 shadow-sm">
        <p class="font-bold text-emerald-900"><%= success %></p>
      </div>
    <% } %>

    <!-- Sanitization Diff Preview (Before vs After) -->
    <% if (sanitizedDiff) { %>
      <div class="bg-white border border-slate-200 rounded-xl p-5 mb-6 shadow-sm">
        <h3 class="text-sm font-bold text-slate-800 mb-2 flex items-center gap-2">
          <span>🧹</span> Bukti Sanitasi Data (Before vs After Sanitasi Server):
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
          <div class="bg-slate-100 border border-slate-300 rounded-lg p-3">
            <span class="font-semibold text-slate-600 block mb-1">Sebelum Sanitasi (Raw Form Input):</span>
            <pre class="overflow-x-auto text-slate-700 bg-white p-2 rounded border border-slate-200"><%= JSON.stringify(sanitizedDiff.before, null, 2) %></pre>
          </div>
          <div class="bg-emerald-50 border border-emerald-300 rounded-lg p-3">
            <span class="font-semibold text-emerald-700 block mb-1">Sesudah Sanitasi (Disimpan ke DB & Diproses):</span>
            <pre class="overflow-x-auto text-emerald-900 bg-white p-2 rounded border border-emerald-200"><%= JSON.stringify(sanitizedDiff.after, null, 2) %></pre>
          </div>
        </div>
      </div>
    <% } %>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Form Input Feedback -->
      <div class="lg:col-span-5">
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
          <h2 class="text-lg font-bold text-slate-800 mb-4 pb-2 border-b border-slate-100 flex items-center gap-2">
            <span>✍️</span> Kirim Ulasan / Feedback
          </h2>

          <form method="POST" action="/feedback" class="space-y-4" novalidate>
            <div>
              <label for="input-name" class="block text-xs font-semibold text-slate-600 mb-1">Nama Lengkap (3-50 karakter)</label>
              <input
                type="text"
                id="input-name"
                name="name"
                value="<%= old.name || '' %>"
                placeholder="Contoh: Budi Santoso"
                class="w-full text-sm border border-slate-300 rounded-lg px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition"
              />
            </div>

            <div>
              <label for="input-email" class="block text-xs font-semibold text-slate-600 mb-1">Alamat Email</label>
              <input
                type="text"
                id="input-email"
                name="email"
                value="<%= old.email || '' %>"
                placeholder="nama@domain.com"
                class="w-full text-sm border border-slate-300 rounded-lg px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition"
              />
            </div>

            <div>
              <label for="input-rating" class="block text-xs font-semibold text-slate-600 mb-1">Rating Produk (1 - 5 Bintang)</label>
              <select
                id="input-rating"
                name="rating"
                class="w-full text-sm border border-slate-300 rounded-lg px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white transition"
              >
                <option value="">-- Pilih Rating --</option>
                <option value="5" <%= old.rating === '5' ? 'selected' : '' %>>⭐⭐⭐⭐⭐ (5 - Sangat Memuaskan)</option>
                <option value="4" <%= old.rating === '4' ? 'selected' : '' %>>⭐⭐⭐⭐ (4 - Bagus)</option>
                <option value="3" <%= old.rating === '3' ? 'selected' : '' %>>⭐⭐⭐ (3 - Cukup)</option>
                <option value="2" <%= old.rating === '2' ? 'selected' : '' %>>⭐⭐ (2 - Kurang)</option>
                <option value="1" <%= old.rating === '1' ? 'selected' : '' %>>⭐ (1 - Buruk)</option>
              </select>
            </div>

            <div>
              <label for="input-comment" class="block text-xs font-semibold text-slate-600 mb-1">Komentar / Ulasan (5-500 karakter)</label>
              <textarea
                id="input-comment"
                name="comment"
                rows="4"
                placeholder="Tulis ulasan Anda di sini..."
                class="w-full text-sm border border-slate-300 rounded-lg px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition"
              ><%= old.comment || '' %></textarea>
            </div>

            <button
              type="submit"
              id="btn-submit-feedback"
              class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 px-4 rounded-lg text-sm shadow transition duration-150"
            >
              Kirim Feedback Aman 🚀
            </button>
          </form>
        </div>
      </div>

      <!-- Daftar Feedback Tersimpan (HTML-Escaped Output) -->
      <div class="lg:col-span-7">
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
          <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-100">
            <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
              <span>💬</span> Ulasan Pelanggan
            </h2>
            <span class="text-xs font-medium text-slate-500 bg-slate-100 px-2.5 py-1 rounded-full">
              <%= feedbacks.length %> Ulasan Terdaftar
            </span>
          </div>

          <% if (feedbacks.length === 0) { %>
            <div class="text-center py-12 text-slate-400">
              <svg class="w-12 h-12 mx-auto mb-2 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
              <p class="text-sm">Belum ada ulasan yang tersimpan.</p>
            </div>
          <% } else { %>
            <div class="space-y-4 max-h-[520px] overflow-y-auto pr-1">
              <% feedbacks.forEach(function(item) { %>
                <div class="border border-slate-200 rounded-xl p-4 bg-slate-50/50 hover:bg-slate-50 transition">
                  <div class="flex items-center justify-between mb-1.5">
                    <div class="flex items-center gap-2">
                      <div class="w-7 h-7 rounded-full bg-indigo-600 text-white text-xs font-bold flex items-center justify-center">
                        <%= item.name.charAt(0).toUpperCase() %>
                      </div>
                      <span class="font-bold text-sm text-slate-800"><%= item.name %></span>
                      <span class="text-xs text-slate-400">&bull; <%= item.email %></span>
                    </div>
                    <div class="text-xs font-semibold text-amber-500">
                      <% for (let i = 0; i < item.rating; i++) { %>★<% } %>
                      <span class="text-slate-400 font-normal">(<%= item.rating %>/5)</span>
                    </div>
                  </div>
                  <!-- PENTING: Menggunakan <%= %> untuk HTML Escaping yang aman -->
                  <div class="text-sm text-slate-700 bg-white border border-slate-200 rounded-lg p-3 break-words font-mono text-xs">
                    <%= item.comment %>
                  </div>
                  <div class="text-[11px] text-slate-400 mt-2 text-right">
                    Tersimpan pada: <%= new Date(item.createdAt).toLocaleString('id-ID') %>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
